  "components": {
    "parameters": {
      "ApiVersionHeader": {
        "name": "X-API-Version",
        "in": "header",
        "required": false,
        "description": "Optional API version header used to pin the schema version (defaults to 'v1' / '2026-10-26').",
        "schema": {
          "type": "string",
          "default": "v1",
          "enum": ["v1", "2026-10-26"]
        }
      },
      "SandboxApiKeyHeader": {
        "name": "X-API-Key",
        "in": "header",
        "required": false,
        "description": "Optional sandbox API key for testing authenticated agent workflows (demo key: 'lgs_sandbox_demo_key_v1').",
        "schema": {
          "type": "string",
          "default": "lgs_sandbox_demo_key_v1"
        }
      }
    },
    "headers": {
      "XApiVersion": {
        "description": "Active REST API version serving the response",
        "schema": {
          "type": "string",
          "example": "v1"
        }
      },
      "Deprecation": {
        "description": "RFC 9745 Deprecation header emitted at least 90 days before an endpoint is retired",
        "schema": {
          "type": "string",
          "example": "false"
        }
      },
      "Sunset": {
        "description": "RFC 8594 Sunset HTTP-date header indicating when a deprecated endpoint will become unresponsive",
        "schema": {
          "type": "string",
          "format": "date-time",
          "example": "Wed, 01 Jan 2031 00:00:00 GMT"
        }
      },
      "RateLimitLimit": {
        "description": "Maximum number of requests permitted in the current 60-second window (RFC RateLimit)",
        "schema": {
          "type": "integer",
          "example": 60
        }
      },
      "RateLimitRemaining": {
        "description": "Remaining number of requests permitted in the current window (RFC RateLimit)",
        "schema": {
          "type": "integer",
          "example": 59
        }
      },
      "RateLimitReset": {
        "description": "Seconds remaining until the current rate-limit window resets (RFC RateLimit)",
        "schema": {
          "type": "integer",
          "example": 60
        }
      },
