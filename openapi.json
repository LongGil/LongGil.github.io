    "/": {
      "get": {
        "operationId": "getHomepage",
        "summary": "Homepage (HTML or Markdown via Content Negotiation)",
        "description": "Returns the Long Gil Studio homepage with studio overview, featured projects (GilongWorld, Fruit Dodgeball, CTU-KHHT, Cute Hide), and FAQ. Supports content negotiation via the Accept header (text/html or text/markdown).",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "Content negotiation header. Use 'text/markdown' to request Markdown or 'text/html' for HTML.",
            "schema": {
              "type": "string",
              "default": "text/html",
              "enum": ["text/html", "text/markdown", "application/json"]
            }
          },
          { "$ref": "#/components/parameters/ApiVersionHeader" }
        ],
        "responses": {
          "200": {
            "description": "Homepage content in HTML or Markdown format",
            "headers": {
              "Vary": {
                "description": "Indicates response varies based on the Accept request header",
                "schema": {
                  "type": "string",
                  "example": "Accept"
                }
              },
              "X-API-Version": { "$ref": "#/components/headers/XApiVersion" }
            },
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              },
              "text/markdown": {
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequestError" },
          "404": { "$ref": "#/components/responses/NotFoundError" },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "default": { "$ref": "#/components/responses/DefaultError" }
        }
      }
    },
    "/index.md": {
      "get": {
