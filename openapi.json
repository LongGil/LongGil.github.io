{
  "openapi": "3.1.0",
  "info": {
    "title": "Long Gil Studio REST API & Content Specification (v1)",
    "summary": "Versioned REST API (/v1/) and machine-readable content endpoints for Long Gil Studio (longgilstudio.com).",
    "description": "Long Gil Studio is an independent game development studio from Vietnam, pioneering the AAA Indie Game (Triple-I) movement.\n\n## API Versioning Policy\n- **URL Path Versioning**: All REST API endpoints are versioned using explicit URL path prefixes (`/v1/...` and `/api/v1/...`). Future breaking changes will be published under `/v2/` and `/api/v2/`.\n- **Header Versioning**: Clients and AI agents may also negotiate or pin schema versions via the `X-API-Version` request header (e.g., `X-API-Version: v1` or `X-API-Version: 2026-10-26`). Every response echoes `X-API-Version`.\n\n## Deprecation & Sunset Policy\n- **Deprecation Header (RFC 9745)**: When an endpoint or API version is scheduled for retirement, responses include the standard `Deprecation: @<unix-timestamp>` header.\n- **Sunset Header (RFC 8594)**: Deprecated endpoints include a `Sunset: <HTTP-date>` header and a `Link: <https://longgilstudio.com/openapi.json>; rel=\"sunset\"` header indicating the exact retirement date.\n- **Notice Timeline**: Deprecated versions remain operational for a minimum of **90 days** after deprecation notice before sunset.",
    "version": "1.2.0",
    "contact": {
      "name": "Long Gil Studio",
      "url": "https://longgilstudio.com",
      "email": "info@longgilstudio.com"
    },
    "license": {
      "name": "All Rights Reserved",
      "url": "https://longgilstudio.com/"
    },
    "x-logo": {
      "url": "https://longgilstudio.com/assets/img/nature/logo_GL_nb2.png"
    },
    "x-api-versioning": {
      "strategy": ["url-path", "header"],
      "current_version": "v1",
      "supported_versions": ["v1"],
      "path_prefix": "/v1",
      "header_name": "X-API-Version"
    },
    "x-deprecation-policy": {
      "minimum_notice_days": 90,
      "headers": ["Deprecation", "Sunset", "Link"],
      "policy_url": "https://longgilstudio.com/openapi.json"
    }
  },
  "servers": [
    {
      "url": "https://longgilstudio.com",
      "description": "Production Root Server"
    },
    {
      "url": "https://longgilstudio.com/v1",
      "description": "Production REST API v1"
    },
    {
      "url": "https://longgilstudio.com/api/v1",
      "description": "Production REST API v1 (Alias)"
    }
  ],
  "paths": {
    "/v1/studio.json": {
      "get": {
        "operationId": "getStudioV1",
        "summary": "Get Long Gil Studio metadata (v1)",
        "description": "Returns structured JSON metadata about Long Gil Studio, founder profile, API versioning/deprecation status, and canonical endpoints.",
        "parameters": [
          { "$ref": "#/components/parameters/ApiVersionHeader" }
        ],
        "responses": {
          "200": {
            "description": "Studio metadata JSON (v1)",
            "headers": {
              "X-API-Version": { "$ref": "#/components/headers/XApiVersion" },
              "Deprecation": { "$ref": "#/components/headers/Deprecation" },
              "Sunset": { "$ref": "#/components/headers/Sunset" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StudioResponseV1" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequestError" },
          "404": { "$ref": "#/components/responses/NotFoundError" },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "default": { "$ref": "#/components/responses/DefaultError" }
        }
      }
    },
