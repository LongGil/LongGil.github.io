  "components": {
    "parameters": {
      "ApiVersionHeader": {
        "name": "X-API-Version",
        "in": "header",
        "required": false,
        "description": "Optional API version header used to pin the schema version (defaults to 'v1' / '2026-10-26').",
        "schema": {
          "type": "string",
          "default": "v1",
          "enum": ["v1", "2026-10-26"]
        }
      }
    },
    "headers": {
      "XApiVersion": {
        "description": "Active REST API version serving the response",
        "schema": {
          "type": "string",
          "example": "v1"
        }
      },
      "Deprecation": {
        "description": "RFC 9745 Deprecation header emitted at least 90 days before an endpoint is retired",
        "schema": {
          "type": "string",
          "example": "false"
        }
      },
      "Sunset": {
        "description": "RFC 8594 Sunset HTTP-date header indicating when a deprecated endpoint will become unresponsive",
        "schema": {
          "type": "string",
          "format": "date-time",
          "example": "Wed, 01 Jan 2031 00:00:00 GMT"
        }
      }
    },
    "schemas": {
      "StudioResponseV1": {
        "type": "object",
        "required": ["api_version", "schema_version", "deprecation", "studio", "endpoints"],
        "properties": {
          "api_version": { "type": "string", "example": "v1" },
          "schema_version": { "type": "string", "example": "2026-10-26" },
          "deprecation": {
            "type": "object",
            "properties": {
              "deprecated": { "type": "boolean", "example": false },
              "sunset": { "type": ["string", "null"], "example": null },
              "policy": { "type": "string" },
              "policy_url": { "type": "string", "format": "uri" }
            }
          },
          "studio": { "type": "object" },
          "endpoints": { "type": "object" }
        }
      },
      "ProjectsResponseV1": {
        "type": "object",
        "required": ["api_version", "schema_version", "projects"],
        "properties": {
          "api_version": { "type": "string", "example": "v1" },
          "schema_version": { "type": "string", "example": "2026-10-26" },
          "projects": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "message", "status", "hint", "resolution", "error"],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "URI reference identifying the problem type",
            "example": "https://longgilstudio.com/openapi.json#components/schemas/ErrorResponse"
          },
          "title": {
            "type": "string",
            "description": "Short human-readable summary of the problem type",
            "example": "Resource Not Found"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code",
            "example": 404
          },
          "code": {
            "type": "string",
            "description": "Machine-readable error code",
            "example": "RESOURCE_NOT_FOUND"
          },
          "message": {
            "type": "string",
            "description": "Human- and agent-readable explanation of the error",
            "example": "The requested URL or API endpoint does not exist on longgilstudio.com."
          },
          "hint": {
            "type": "string",
            "description": "Concise remediation hint for AI agents",
            "example": "Consult /openapi.json, /v1/studio.json, or /llms.txt for valid endpoints."
          },
          "resolution": {
            "type": "string",
            "description": "Actionable instructions for agents on how to resolve the error",
            "example": "Check valid endpoints in https://longgilstudio.com/openapi.json, https://longgilstudio.com/api/openapi.yaml, or https://longgilstudio.com/llms.txt."
          },
          "error": {
            "type": "object",
            "required": ["code", "status", "message", "hint", "resolution"],
            "properties": {
              "code": { "type": "string", "example": "RESOURCE_NOT_FOUND" },
              "status": { "type": "integer", "example": 404 },
              "message": { "type": "string", "example": "The requested URL or API endpoint does not exist on longgilstudio.com." },
              "hint": { "type": "string", "example": "Consult /openapi.json, /v1/studio.json, or /llms.txt for valid endpoints." },
              "resolution": { "type": "string", "example": "Check valid endpoints in https://longgilstudio.com/openapi.json or https://longgilstudio.com/llms.txt." },
              "documentation_url": { "type": "string", "format": "uri", "example": "https://longgilstudio.com/openapi.json" },
              "available_endpoints": {
                "type": "array",
                "items": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequestError": {
        "description": "Invalid request parameters or unsupported version header (structured JSON error response).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          },
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFoundError": {
        "description": "The requested resource was not found (structured JSON error response or Markdown 404 body via content negotiation).",
        "headers": {
          "Vary": {
            "description": "Indicates error format varies by Accept header (application/json, text/markdown, text/html)",
            "schema": { "type": "string", "example": "Accept" }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "type": "https://longgilstudio.com/openapi.json#components/schemas/ErrorResponse",
              "title": "Resource Not Found",
              "status": 404,
              "code": "RESOURCE_NOT_FOUND",
              "message": "The requested URL or API endpoint does not exist on longgilstudio.com.",
              "hint": "Consult /openapi.json, /v1/studio.json, or /llms.txt for valid endpoints.",
              "resolution": "Check valid endpoints in https://longgilstudio.com/openapi.json, https://longgilstudio.com/api/openapi.yaml, or https://longgilstudio.com/llms.txt.",
              "error": {
                "code": "RESOURCE_NOT_FOUND",
                "status": 404,
                "message": "The requested URL or API endpoint does not exist on longgilstudio.com.",
                "hint": "Consult /openapi.json, /v1/studio.json, or /llms.txt for valid endpoints.",
                "resolution": "Check valid endpoints in https://longgilstudio.com/openapi.json or https://longgilstudio.com/llms.txt.",
                "documentation_url": "https://longgilstudio.com/openapi.json"
              }
            }
          },
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          },
          "text/markdown": {
            "schema": { "type": "string" }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected server error (structured JSON error response).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          },
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "DefaultError": {
        "description": "Structured JSON error response with error code, message, hint, and resolution.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          },
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  },
  "externalDocs": {
    "description": "LLMs.txt — Machine-readable studio overview for AI agents",
    "url": "https://longgilstudio.com/llms.txt"
  }
}
